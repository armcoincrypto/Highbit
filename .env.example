# Highbit CNY Transfer Bot - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Bot Configuration
# =============================================================================

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram Channel ID for daily posts
# IMPORTANT: Channel IDs start with -100 (e.g., -1001234567890)
# To find your channel ID:
#   1. Forward a message from the channel to @userinfobot
#   2. Or add bot to channel, send a message, check logs
# IMPORTANT: Bot must be added to the channel as ADMIN with "Post Messages" permission
# You can also use @channelname format (e.g., @Highbitchannel)
CHANNEL_ID=

# Admin Chat ID for transfer request notifications (can be group or user ID)
# Groups also start with -100 prefix
ADMIN_CHAT_ID=

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

# Comma-separated list of Telegram user IDs who can use admin commands
# Example: ADMIN_IDS=123456789,987654321
# To find your user ID, send /start to @userinfobot
ADMIN_IDS=

# =============================================================================
# TIMEZONE & SCHEDULING
# =============================================================================

# Timezone for scheduled posts (default: Asia/Yerevan)
TIMEZONE=Asia/Yerevan

# =============================================================================
# PRICING CONFIGURATION (New Transfer System)
# =============================================================================

# Minimum order size in CNY (default: 5000)
MIN_ORDER_CNY=5000

# Discount threshold in USD equivalent (default: 4000)
# Orders >= this amount get higher discount tier
DISCOUNT_THRESHOLD_USD=4000

# Discounts for FIAT payments (AMD/USD/RUB)
# Negative values = user pays less
DISCOUNT_FIAT_HIGH=-0.010    # -1.0% for >= $4000 USD equiv
DISCOUNT_FIAT_LOW=-0.015     # -1.5% for < $4000 USD equiv

# Discounts for USDT payments
DISCOUNT_USDT_HIGH=-0.005    # -0.5% for >= $4000 USD equiv
DISCOUNT_USDT_LOW=-0.010     # -1.0% for < $4000 USD equiv

# =============================================================================
# HTX P2P CONFIGURATION
# =============================================================================

# P2P.Army API Key (RECOMMENDED - normalized P2P data)
# Get your API key from: https://p2p.army/en/api_docs
# This is the PREFERRED source for P2P rates.
# If not set, bot will fallback to direct HTX/Binance APIs (less reliable)
P2P_ARMY_API_KEY=

# HTX P2P rate cache TTL in seconds (default: 45, recommended: 30-60)
HTX_P2P_TTL_SECONDS=45

# Preferred payment methods (comma-separated, lowercase)
# Used to prioritize P2P ads with these methods
HTX_PREFERRED_METHODS=alipay,wechat

# =============================================================================
# CBA (Central Bank of Armenia) CONFIGURATION
# =============================================================================

# CBA rates cache TTL in seconds (default: 900 = 15 minutes)
CBA_RATES_TTL_SECONDS=900

# =============================================================================
# LEGACY RATE MARGINS (for /rates command)
# =============================================================================

# USD/USDT margin (negative = discount)
MARGIN_USD_USDT=-0.025

# AMD/RUB margin
MARGIN_AMD_RUB=0.024

# Treat USDT as having parity with USD
USDT_PARITY_WITH_USD=true

# =============================================================================
# NETWORK & CACHING
# =============================================================================

# General rate cache TTL in seconds (default: 600 = 10 minutes)
RATE_TTL_SECONDS=600

# HTTP request timeout in seconds (default: 8)
HTTP_TIMEOUT=8

# HTTP retry attempts (default: 3)
HTTP_RETRIES=3

# =============================================================================
# DATABASE
# =============================================================================

# SQLite database path (default: /opt/highbitbot/data/highbit.db)
DATABASE_PATH=/opt/highbitbot/data/highbit.db

# =============================================================================
# QUICK SETUP CHECKLIST
# =============================================================================
#
# 1. Create bot with @BotFather and get BOT_TOKEN
# 2. Set ADMIN_IDS to your Telegram user ID
# 3. Create channel for daily posts:
#    - Create channel in Telegram
#    - Add your bot as admin with "Post Messages" permission
#    - Get channel ID (forward message to @userinfobot)
#    - Set CHANNEL_ID here
# 4. (Optional) Get P2P_ARMY_API_KEY from https://p2p.army
# 5. Create data directory: mkdir -p /opt/highbitbot/data
# 6. Start bot: python main.py
# 7. Test: /post_target_test (admin only) to verify channel posting
