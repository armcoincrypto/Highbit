# Highbit Exchange Rates Bot - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - Bot Configuration
# =============================================================================

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram Channel ID for daily posts (e.g., -1001234567890 or @channelname)
CHANNEL_ID=

# =============================================================================
# OPTIONAL - Admin Configuration
# =============================================================================

# Comma-separated list of Telegram user IDs who can use admin commands
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# =============================================================================
# OPTIONAL - Timezone & Scheduling
# =============================================================================

# Timezone for scheduled posts (default: Asia/Yerevan)
TIMEZONE=Asia/Yerevan

# =============================================================================
# OPTIONAL - Rate Margins (Business Logic)
# =============================================================================

# USD/USDT margin (negative = discount, e.g., -0.025 = -2.5%)
MARGIN_USD_USDT=-0.025

# AMD/RUB margin (e.g., 0.024 = +2.4%)
MARGIN_AMD_RUB=0.024

# Treat USDT as having parity with USD (true/false)
USDT_PARITY_WITH_USD=true

# =============================================================================
# OPTIONAL - Network & Caching
# =============================================================================

# Rate cache TTL in seconds (default: 600 = 10 minutes)
RATE_TTL_SECONDS=600

# HTTP request timeout in seconds (default: 8)
HTTP_TIMEOUT=8

# HTTP retry attempts (default: 3)
HTTP_RETRIES=3
